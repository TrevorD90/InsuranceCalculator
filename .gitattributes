# Normalise line endings in the repository to LF. Checkouts still get native endings on
# Windows, but the stored blobs stay consistent — this project builds for macOS as well.
* text=auto eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.pdf binary

# Generated. Collapsed in GitHub diffs and excluded from language statistics, but still a
# readable text diff locally — `-diff` would hide real dependency changes from review.
package-lock.json linguist-generated
